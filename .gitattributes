# Keep every detected text file reproducible across development environments.
* text=auto eol=lf

*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.py text eol=lf

*.icns binary !eol
*.png binary !eol
*.dylib binary !eol
*.node binary !eol
