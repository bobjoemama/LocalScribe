{
  "name": "localscribe",
  "productName": "LocalScribe",
  "version": "0.1.0-dev.20",
  "description": "Local-first desktop dictation for Apple Silicon Macs.",
  "author": "Devesh",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobjoemama/LocalScribe.git"
  },
  "homepage": "https://github.com/bobjoemama/LocalScribe",
  "packageManager": "npm@11.16.0",
  "main": ".vite/build/main.js",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "npm run package:mac",
    "make": "npm run make:mac",
    "package:mac": "npm run worker:bundle && node scripts/run-forge-target.mjs package darwin",
    "make:mac": "npm run worker:bundle && node scripts/run-forge-target.mjs make darwin",
    "worker:sync": "UV_PROJECT_ENVIRONMENT=../.worker-venv uv sync --project worker --locked --no-dev --python 3.12.13",
    "worker:bundle": "bash scripts/build-worker-runtime.sh",
    "worker:check-locks": "uv lock --check --project worker && uv lock --check --project tools/python-audit",
    "toolchain:verify:npm": "node scripts/verify-npm-version.mjs",
    "toolchain:verify": "node scripts/verify-toolchain.mjs",
    "verify:packaged-main": "node scripts/verify-packaged-main.mjs",
    "verify:packaged-archive": "node scripts/verify-packaged-archive.mjs",
    "verify:macos-entitlements": "node scripts/verify-macos-entitlements.mjs",
    "verify:macos-bundle": "node scripts/verify-macos-bundle.mjs",
    "verify:macos-artifacts": "node scripts/verify-macos-artifacts.mjs",
    "verify:release-assets:macos": "node scripts/verify-release-assets.mjs --platform darwin",
    "smoke:packaged:macos": "bash scripts/smoke-packaged-macos.sh",
    "verify:local": "node scripts/verify-local-source.mjs",
    "verify:local:macos": "bash scripts/verify-local-macos.sh",
    "ci": "npm run verify:local",
    "ci:macos": "bash scripts/verify-local-macos.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "eslint . --max-warnings 0",
    "lint:python:macos": "uv run --project worker --locked --only-dev ruff check --config worker/pyproject.toml worker/localscribe_worker worker/tests scripts/smoke-worker.py scripts/prune-mlx-audio-whisper.py scripts/reconcile-python-sbom.py scripts/test-pip-url-boundary.py",
    "lint:all": "npm run lint && npm run lint:python:macos",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-bounded-vitest.mjs",
    "test:settings-layout": "node scripts/test-settings-scroll-layout.mjs",
    "test:macos-accessibility-target": "node scripts/test-macos-accessibility-target.mjs",
    "test:packaging": "node scripts/run-bounded-vitest.mjs tests/packageInventory.test.ts tests/packageProvenance.test.ts tests/releaseMetadata.test.ts tests/releaseAssets.test.ts tests/macPackagingRelease.test.ts tests/resourceIntegrity.test.ts tests/buildSecurity.test.ts tests/makeResultSafety.test.ts",
    "test:watch": "vitest",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit:all": "node scripts/audit-npm-all.mjs",
    "audit:model-sources": "node scripts/audit-model-sources.mts",
    "audit:python": "node scripts/audit-python-deps.mjs",
    "sbom:runtime:macos": "node scripts/generate-runtime-sbom.mjs --platform darwin --source-only",
    "sbom:runtime:macos:candidate": "node scripts/generate-runtime-sbom.mjs --platform darwin",
    "sbom:python:macos": "uv export --project worker --locked --no-dev --format cyclonedx1.5 --preview-features sbom-export"
  },
  "dependencies": {
    "better-sqlite3": "13.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uiohook-napi": "1.5.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@electron/osx-sign": "1.3.3",
    "@electron/rebuild": "4.2.0",
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "2.10.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.2.0",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.11",
    "yauzl": "2.10.0"
  },
  "overrides": {
    "@electron/rebuild": "4.2.0",
    "tar": "7.5.21",
    "tmp": "0.2.7"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "fs-xattr@0.3.1": true,
    "fsevents": false,
    "macos-alias@0.2.12": true,
    "uiohook-napi@1.5.5": true
  }
}
