{
  "name": "localscribe",
  "productName": "LocalScribe",
  "version": "0.1.0-dev.5",
  "description": "Private, local-first AI desktop dictation with Whisper and Qwen3-ASR for macOS and Windows.",
  "author": "Devesh",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobjoemama/LocalScribe.git"
  },
  "homepage": "https://github.com/bobjoemama/LocalScribe",
  "packageManager": "npm@11.16.0",
  "main": ".vite/build/main.js",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "package:mac": "npm run worker:bundle && node scripts/run-forge-target.mjs package darwin",
    "make:mac": "npm run worker:bundle && node scripts/run-forge-target.mjs make darwin",
    "package:windows": "npm run worker:bundle:windows && npm run native:build:windows && node scripts/run-forge-target.mjs package win32",
    "make:windows": "npm run worker:bundle:windows && npm run native:build:windows && node scripts/run-forge-target.mjs make win32",
    "worker:sync": "UV_PROJECT_ENVIRONMENT=../.worker-venv uv sync --project worker --locked --no-dev --python 3.12.13",
    "worker:bundle": "bash scripts/build-worker-runtime.sh",
    "worker:bundle:windows": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/build-worker-runtime.ps1",
    "worker:check-locks": "uv lock --check --project worker && uv lock --check --project worker/windows_transformers && uv lock --check --project tools/python-audit",
    "worker:test:windows": "uv run --project worker/windows_transformers --locked python -B -m unittest discover -s worker/windows_transformers/tests -v",
    "native:build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File resources/native/windows/build.ps1",
    "toolchain:verify:npm": "node scripts/verify-npm-version.mjs",
    "toolchain:verify": "node scripts/verify-toolchain.mjs",
    "verify:packaged-main": "node scripts/verify-packaged-main.mjs",
    "verify:packaged-archive": "node scripts/verify-packaged-archive.mjs",
    "verify:macos-entitlements": "node scripts/verify-macos-entitlements.mjs",
    "verify:macos-bundle": "node scripts/verify-macos-bundle.mjs",
    "verify:macos-artifacts": "node scripts/verify-macos-artifacts.mjs",
    "verify:squirrel-artifacts": "node scripts/verify-squirrel-artifacts.mjs",
    "verify:windows:portable": "node scripts/verify-windows-portable.mjs",
    "verify:release-assets:macos": "node scripts/verify-release-assets.mjs --platform darwin",
    "verify:release-assets:windows": "node scripts/verify-release-assets.mjs --platform win32",
    "smoke:packaged:macos": "bash scripts/smoke-packaged-macos.sh",
    "smoke:packaged:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-packaged-windows.ps1",
    "verify:windows:source": "node scripts/verify-windows-source.mjs",
    "verify:local": "node scripts/verify-local-source.mjs",
    "verify:local:macos": "bash scripts/verify-local-macos.sh",
    "ci": "npm run verify:local",
    "ci:macos": "npm run verify:local:macos",
    "hooks:install": "git config core.hooksPath .githooks",
    "verify:local:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-local-windows.ps1",
    "lint": "eslint . --max-warnings 0",
    "lint:python:macos": "uv run --project worker --locked --only-dev ruff check --config worker/pyproject.toml worker/localscribe_worker worker/tests scripts/smoke-worker.py",
    "lint:python:windows": "uv run --project worker --locked --only-dev ruff check --config worker/pyproject.toml worker/windows_transformers/localscribe_windows_worker worker/windows_transformers/tests scripts/smoke-windows-cuda.py",
    "lint:all": "npm run lint && npm run lint:python:macos && npm run lint:python:windows",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:settings-layout": "node scripts/test-settings-scroll-layout.mjs",
    "test:packaging": "vitest run tests/packageInventory.test.ts tests/packageProvenance.test.ts tests/releaseMetadata.test.ts tests/releaseAssets.test.ts tests/macPackagingRelease.test.ts tests/resourceIntegrity.test.ts tests/buildSecurity.test.ts tests/makeResultSafety.test.ts tests/squirrelInstallerVerifier.test.ts tests/windowsArtifactSafety.test.ts tests/windowsPortableVerifier.test.ts",
    "test:watch": "vitest",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit:all": "node scripts/audit-npm-all.mjs",
    "audit:python": "node scripts/audit-python-deps.mjs",
    "sbom:runtime:macos": "node scripts/generate-runtime-sbom.mjs --platform darwin",
    "sbom:runtime:windows": "node scripts/generate-runtime-sbom.mjs --platform win32",
    "sbom:python:macos": "uv export --project worker --locked --no-dev --format cyclonedx1.5 --preview-features sbom-export",
    "sbom:python:windows": "uv export --project worker/windows_transformers --locked --no-dev --format cyclonedx1.5 --preview-features sbom-export"
  },
  "dependencies": {
    "better-sqlite3": "13.0.1",
    "electron-squirrel-startup": "1.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uiohook-napi": "1.5.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@electron/osx-sign": "1.3.3",
    "@electron/rebuild": "4.2.0",
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.2.0",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "extract-zip": "2.0.1",
    "globals": "17.7.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.0"
  },
  "overrides": {
    "@electron/rebuild": "4.2.0",
    "tar": "7.5.21",
    "tmp": "0.2.7"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "electron-winstaller@5.4.4": true,
    "fs-xattr@0.3.1": true,
    "fsevents": false,
    "macos-alias@0.2.12": true,
    "uiohook-napi@1.5.5": true
  }
}
