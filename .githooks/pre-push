#!/usr/bin/env bash
#
# Runs the source-level gate suite before anything reaches the remote.
#
# LocalScribe also runs this source pipeline in read-only pull-request and main
# branch CI. The local hook catches failures before network publication; hosted
# CI independently checks the reviewed or pushed commit. Both invoke the same entry point — toolchain
# pins, both npm audits, dependency locks, lint, typecheck, and the full test
# suite — so the two paths cannot intentionally drift.
#
# It deliberately does NOT run the macOS packaging gates. Those need an Apple
# Silicon machine, signing identity, and several minutes; making every push pay
# that cost would only teach people to reach for --no-verify. Run `npm run
# ci:macos` before publishing a release.
#
# Install with: npm run hooks:install
# Bypass, when you genuinely mean to: git push --no-verify
set -euo pipefail

# Pushing only deletions has nothing to verify.
only_deletes=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  if [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
    only_deletes=0
  fi
done
if [ "$only_deletes" -eq 1 ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Git exports repository-local variables to hooks. The gate starts fixture
# repositories, so its child must discover Git metadata from each fixture's
# working directory instead of inheriting this push's linked-worktree GIT_DIR.
# https://git-scm.com/docs/githooks#_description
git_local_env_vars="$(git rev-parse --local-env-vars)"

echo "pre-push: running the local gate suite (npm run ci)"
if ! (
  for git_local_env_var in $git_local_env_vars; do
    unset "$git_local_env_var"
  done
  npm run --silent ci
); then
  echo ""
  echo "pre-push: gates failed - push refused."
  echo "  Fix the failure, or use 'git push --no-verify' if you accept it."
  exit 1
fi
echo "pre-push: gates passed."
